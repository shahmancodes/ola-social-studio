AI_GATEWAY_API_KEY=
VERCEL_AI_MODEL=openai/gpt-6-luna
VERCEL_AI_VISION_MODEL=openai/gpt-6-luna
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3.6-35b-a3b
OPENROUTER_VISION_MODEL=

# Optional WhatsApp Business integration.
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_DISPLAY_NUMBER=
WHATSAPP_API_VERSION=v22.0
# Approved Meta completion template name, with one body parameter for the link.
WHATSAPP_COMPLETION_TEMPLATE=
# Public HTTPS origin of the current tunnel; restart worker after changing it.
PUBLIC_BASE_URL=

# Canva app credentials. Register CANVA_REDIRECT_URI as an OAuth redirect URL
# in Canva, for example https://your-domain.com/api/canva/callback.
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
CANVA_REDIRECT_URI=
# Generate once with: openssl rand -base64 32
CANVA_TOKEN_ENCRYPTION_KEY=

# Optional local Ola Sentinel. Run with npm run dev:compare.
# Ordinary Ola keeps .data by default; the launcher isolates lab projects automatically.
OLA_DATA_DIR=
COMPARISON_DATA_DIR=
COMPARISON_SOURCE_DATA_DIR=
# Set to 1 ONLY after Canva confirms this benchmarking use is permitted.
COMPARISON_CANVA_PERMITTED=0
COMPARISON_CANVA_CLIENT_ID=
COMPARISON_CANVA_CLIENT_SECRET=
# Generate once: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
COMPARISON_CANVA_TOKEN_KEY=
# Register this exact comparison OAuth redirect in the Canva developer portal:
# http://127.0.0.1:3100/api/canva/callback
